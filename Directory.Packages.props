<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- the tool -->
  <ItemGroup>
    <PackageVersion Include="MinVer" Version="6.0.0" />
    <PackageVersion Include="Nullean.Argh" Version="0.18.0" />
    <PackageVersion Include="NuGet.Versioning" Version="6.13.1" />
    <PackageVersion Include="Octokit" Version="14.0.0" />
  </ItemGroup>

  <!-- build/scripts -->
  <ItemGroup>
    <!-- under CPM the F# SDK adds no implicit FSharp.Core: this is the version the build resolved before -->
    <PackageVersion Include="FSharp.Core" Version="11.0.101" />
    <PackageVersion Include="Argu" Version="6.0.0" />
    <PackageVersion Include="Bullseye" Version="6.0.0" />
    <PackageVersion Include="Fake.Tools.Git" Version="5.15.0" />
    <PackageVersion Include="Proc" Version="0.14.0" />
  </ItemGroup>
</Project>
