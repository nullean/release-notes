<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- the tool -->
  <ItemGroup>
    <PackageVersion Include="MinVer" Version="8.0.0" />
    <PackageVersion Include="Nullean.Argh" Version="0.28.0" />
    <!-- NuGet.Versioning 8 targets only net10.0 and net472: net8.0 would fall back to the .NET Framework build (NU1701) -->
    <PackageVersion Include="NuGet.Versioning" Version="8.0.0" Condition="'$(TargetFramework)' != 'net8.0'" />
    <PackageVersion Include="NuGet.Versioning" Version="7.9.0" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageVersion Include="Octokit" Version="14.0.0" />
  </ItemGroup>

  <!-- build/scripts -->
  <ItemGroup>
    <!-- under CPM the F# SDK adds no implicit FSharp.Core; Nullean.Make.Fs needs 11.0.100 or later -->
    <PackageVersion Include="FSharp.Core" Version="11.0.101" />
    <!-- brings Proc and Proc.Fs -->
    <PackageVersion Include="Nullean.Make.Fs" Version="0.28.0" />
  </ItemGroup>
</Project>
